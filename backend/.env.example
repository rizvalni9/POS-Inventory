# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_kasir_stok
DB_USER=root
DB_PASSWORD=

# JWT Secrets & Expiration
# In production, use strong random secrets generated via crypto.randomBytes(32).toString('hex')
JWT_ACCESS_SECRET=pos_jwt_access_super_secret_key_2026_change_in_production
JWT_REFRESH_SECRET=pos_jwt_refresh_super_secret_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Security & Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_SALT_ROUNDS=10
